{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Release: Linux",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/.devcontainer/build-release.ps1", "-Target", "linux"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Release: Windows",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/.devcontainer/build-release.ps1", "-Target", "windows"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Release: Android",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/.devcontainer/build-release.ps1", "-Target", "android"],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Release: All",
            "type": "process",
            "command": "pwsh",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/.devcontainer/build-release.ps1", "-Target", "all"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
